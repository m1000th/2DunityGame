# =============================================================
#  .gitignore para Unity  ·  2DunityGame / Verdict Zero
# =============================================================
#  Fusion de la configuracion inicial de gastx con los ajustes
#  que necesita este proyecto en concreto (Plastic, .slnx).
#
#  Las rutas van ancladas con "/" al principio para que solo
#  afecten a la raiz del proyecto: sin la barra, una carpeta de
#  arte llamada "Build" o "Temp" dentro de Assets/ se ignoraria
#  sin querer y nadie se enteraria.
#
#  Lo que SI se sube: Assets/ (con todos sus .meta),
#  ProjectSettings/ y Packages/
# -------------------------------------------------------------

# --- Carpetas generadas por Unity (aqui pesan >2 GB) ---------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Unity Version Control (Plastic) -------------------------
# Este proyecto tenia un workspace de Plastic. Se ignora para
# que no ensucie el historial de Git.
/.plastic/
ignore.conf
/[Aa]ssets/Plugins/PlasticSCM*

# --- Editores e IDE ------------------------------------------
.vs/
.vscode/
.idea/
.vsconfig
.gradle/
/[Aa]ssets/Plugins/Editor/JetBrains*

ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Autogenerados por Unity ---------------------------------
sysinfo.txt
crashlytics-build.properties

# --- Ejecutables y paquetes ----------------------------------
*.apk
*.aab
*.unitypackage
*.app
*.androidlib

# --- Addressables y StreamingAssets --------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Sistema operativo ---------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
