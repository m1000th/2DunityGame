# ============================
# .gitignore para proyectos Unity
# (basado en la plantilla oficial de GitHub para Unity)
# ============================

# Carpetas generadas por Unity que NO se versionan
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Archivos generados por Visual Studio / Rider / VSCode
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos de compilación de Unity
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
.consulo/
*.svd
crashlytics-build.properties

# Auto-generados por Unity al abrir el proyecto
sysinfo.txt

# Caches de paquetes (opcional: si usan Package Manager, no versionar el cache)
[Pp]ackages/*
!Packages/manifest.json
!Packages/packages-lock.json

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de Rider
.idea/

# Archivos de Gradle (Android)
*.androidlib
