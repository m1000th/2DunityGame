# =============================================================
#  .gitattributes  ·  2DunityGame / Verdict Zero
# =============================================================
#  Fusion de la configuracion de gastx con los formatos que usa
#  este proyecto (Aseprite, Input System, Shader Graph, URP).
#
#  1) Los binarios grandes van por Git LFS: sin esto, cada
#     version de cada PNG se acumula para siempre y el
#     repositorio acaba pesando gigas.
#  2) Marca como texto los archivos de Unity que si lo son,
#     para que Git pueda mostrar diferencias.
# -------------------------------------------------------------

# Normalizacion automatica de finales de linea
* text=auto

# --- Archivos de Unity que son texto -------------------------
*.cs                 text diff=csharp
*.unity              text
*.prefab             text
*.asset              text
*.mat                text
*.anim               text
*.controller         text
*.meta               text
*.physicsMaterial    text
*.physicsMaterial2D  text
*.shader             text
*.cginc              text
*.hlsl               text
*.shadergraph        text
*.inputactions       text
*.scenetemplate      text
*.uss                text
*.uxml               text
*.json               text
*.md                 text
*.txt                text

# --- Imagenes y texturas -> LFS ------------------------------
*.png      filter=lfs diff=lfs merge=lfs -text
*.jpg      filter=lfs diff=lfs merge=lfs -text
*.jpeg     filter=lfs diff=lfs merge=lfs -text
*.gif      filter=lfs diff=lfs merge=lfs -text
*.bmp      filter=lfs diff=lfs merge=lfs -text
*.tga      filter=lfs diff=lfs merge=lfs -text
*.tif      filter=lfs diff=lfs merge=lfs -text
*.tiff     filter=lfs diff=lfs merge=lfs -text
*.psd      filter=lfs diff=lfs merge=lfs -text
*.psb      filter=lfs diff=lfs merge=lfs -text
*.ase      filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.exr      filter=lfs diff=lfs merge=lfs -text
*.hdr      filter=lfs diff=lfs merge=lfs -text
*.ai       filter=lfs diff=lfs merge=lfs -text
*.ico      filter=lfs diff=lfs merge=lfs -text

# --- Audio -> LFS --------------------------------------------
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text

# --- Video -> LFS --------------------------------------------
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.webm  filter=lfs diff=lfs merge=lfs -text

# --- Modelos 3D -> LFS ---------------------------------------
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.max   filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text

# --- Fuentes -> LFS ------------------------------------------
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text

# --- Otros binarios -> LFS -----------------------------------
*.dll          filter=lfs diff=lfs merge=lfs -text
*.pdf          filter=lfs diff=lfs merge=lfs -text
*.zip          filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
